AVRAG_API_ADDR=0.0.0.0:8080
AVRAG_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Creem success_url base (falls back to AVRAG_PUBLIC_BASE_URL)
# PUBLIC_APP_BASE_URL=https://app.contextlm.top
AVRAG_RUN_MIGRATIONS=true
AVRAG_OBJECT_ROOT=/home/chuan/.local/share/avrag-dev/objects
PROMPT_DIR=./prompts
PROMPT_SUMMARY_VERSION=v1

# Set DATABASE_URL to enable PostgreSQL-backed M1/M2 runtime.
# Example:
# DATABASE_URL=postgres://avrag:***@127.0.0.1:5432/avrag_rs
DATABASE_URL=postgres://avrag:***@127.0.0.1:5432/avrag_rs
# Optional dedicated DB for smoke-v5 persistent corpus.
RAG_QUALITY_SMOKE_DATABASE_URL=
# Keep 0 to enforce isolated smoke DB preflight checks.
RAG_QUALITY_SMOKE_ALLOW_SHARED_DB=0
# Dedicated DB for product_e2e smoke corpus ingest/reuse (recommended).
# RAG_QUALITY_SMOKE_DATABASE_URL=postgres://avrag:avrag@127.0.0.1:5432/avrag_rs_e2e_smoke

# Allow x-owner-user-id / x-user-id proxy auth. Required for PostgreSQL deployments when the
# trusted frontend proxy forwards identity headers. Memory-only dev mode allows proxy
# auth without this flag. E2E also enables proxy auth via E2E_ENABLED=true.
TRUST_PROXY_AUTH=false

# ======================================
# Queue / Redis
# ======================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
AVRAG_WORKER_QUEUE_GROUP=default
AVRAG_INGESTION_QUEUE_GROUP=default
AVRAG_WORKER_SKIP_STORAGE_PROBE=false

# ======================================
# Retrieval data plane
# ======================================
# milvus | pgvector
# - Local / WSL / private: prefer pgvector (Postgres + extension; no Docker Milvus).
# - SaaS / production scale: milvus.
# Package: postgresql-16-pgvector (or equivalent). Migrations create rag_* tables.
RETRIEVAL_BACKEND=pgvector
# When RETRIEVAL_BACKEND=pgvector, Milvus URL is unused (dims still read from MILVUS_*_DIM).

# Dense backend: vgrag (default) = multi-way seed + hop-2 expand fused into dense chunks;
# ann = pure vector dense (A/B / rollback). SaC surface is client.dense only (no client.graph).
# DENSE_BACKEND=vgrag
# DENSE_BACKEND=ann
#
# Lexical side-car graph_context: product default OFF (graph lives inside dense/VGRAG).
# Set 1 only for legacy eval of lexical force-augment.
RETRIEVAL_GRAPH_AUGMENT=0
# GRAPH_AUGMENT_MAX_RELATIONS=5
# GRAPH_AUGMENT_SEED_LIMIT=8
# GRAPH_EVIDENCE_MARGIN_ABS=0.08
# S+L cursor neighbor merge (default on). Set 0 to disable list/semantic-break fix.
# RETRIEVAL_ADJACENT_MERGE=0

# GRAPH_EVIDENCE_MARGIN_REL=0.90
# GRAPH_EVIDENCE_MAX_K=3

# ======================================
# Milvus retrieval data plane
# ======================================
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION_PREFIX=avrag
MILVUS_TEXT_VECTOR_DIM=1024
MILVUS_MULTIMODAL_VECTOR_DIM=1024
MILVUS_METRIC_TYPE=COSINE
RAG_GRAPH_RETRIEVAL_ENABLED=true
RAG_PARALLEL_CHANNELS_ENABLED=true

# ======================================
# Embedding / Rerank / LLM Models
# ======================================
# SiliconFlow text embedding（2026-08-03：价格 ~1/7）。bge-m3 原生 1024d 且拒绝
# dimensions 参数（400）→ EMBEDDING_DIMENSIONS 必须留空（代码空串→None→不发字段）。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_MS=15000
# Worker alias for text vector sizing. Keep equal to bge-m3 dim (1024).
# Schema sizing only — decoupled from the request-side `dimensions` param
# (2026-08-03: must not flow into embedding.dimensions, bge-m3 rejects it).
AVRAG_EMBEDDING_DIM=1024

# Multimodal embedding / rerank (SiliconFlow VL) + DashScope session key slot
# DASHSCOPE_API_KEY is for ingestion LLM Responses session (not MM).
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 2026-08-04: MM embedding off by default (figure→VLM text; see 2026-08-04-mm-off-vlm-figure-text-plan.md)
#MM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#MM_EMBEDDING_API_KEY=sk-your-siliconflow-key
#MM_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
#MM_EMBEDDING_API_STYLE=openai_vl_embedding
#MM_EMBEDDING_DIMENSIONS=1024
#MM_EMBEDDING_TIMEOUT_MS=30000

# 2026-08-04: MM query path off (see docs/engineering/2026-08-04-mm-off-vlm-figure-text-plan.md)
#MM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
#MM_RERANK_API_KEY=sk-your-siliconflow-key
#MM_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
#MM_RERANK_API_STYLE=openai_vl_rerank
#MM_RERANK_TIMEOUT_MS=30000

# Text rerank (non-VL) - SiliconFlow（2026-08-03）。API_STYLE 留空→走 OpenAI 字符串
# /rerank 路径（bge-reranker 只收裸字符串，与现有 openai_rerank_once 兼容）。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-your-siliconflow-key
RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3
RERANK_API_STYLE=
RERANK_TIMEOUT_MS=15000
RERANK_MAX_DOCS=32
RERANK_MAX_DOC_CHARS=2000

# ======================================
# Unified LLM Configuration
# ======================================
# Agent LLM: Chat, RAG, WebSearch — requires strong agentic reasoning.
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-v4-pro
AGENT_LLM_TIMEOUT_MS=180000
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_ENABLE_THINKING=true
AGENT_LLM_ENABLE_CACHE=true
# Protocol: `openai` (chat completions, default) or `responses` (OpenAI
# Responses API, https://api.deepseek.com/v1/responses). Responses currently
# supports only deepseek-v4-flash (deepseek-v4-pro lands 2026-08).
# AGENT_LLM_API_STYLE=responses

# --- Multi-provider failover pool (optional) -------------------------------
# When either of the two vars below is set, the agent LLM routes through a
# ProviderPool: keys rotate round-robin, and on failure (5xx / network /
# timeout / empty stream) the request fails over to the next member; 429/401/
# 403 cool down only the offending key. Both are fully optional — omit them
# to keep the single-route behavior.
#
# Extra API keys for the primary provider (comma-separated, rotated per request):
# AGENT_LLM_API_KEYS=key1,key2
#
# Fallback providers (JSON array; each entry may use `api_key` or `api_keys`;
# `model`/`timeout_ms`/`rpm_limit`/`tpm_limit`/`enable_thinking`/`enable_cache`
# default to the primary config):
# AGENT_LLM_FALLBACKS=[{"base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"","model":"glm-4.6"},{"base_url":"https://api.siliconflow.cn/v1","api_keys":[""],"model":"Qwen/Qwen2.5-72B-Instruct"}]
#
# Member-level cooldown after a provider-level failure (seconds, default 30):
# AGENT_LLM_FAILOVER_COOLDOWN_SECS=30

# Memory LLM: Session summary, user profile extraction — fast and cheap.
MEMORY_LLM_BASE_URL=https://api.deepseek.com
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=deepseek-v4-flash
MEMORY_LLM_TIMEOUT_MS=30000
MEMORY_LLM_TEMPERATURE=0.2
MEMORY_LLM_ENABLE_THINKING=false

# Worker fact verifier (S5, default OFF): claim-level soft check of worker
# handoffs against observed chunk text. Falls back to MEMORY_LLM_* when
# VERIFY_LLM_* are unset.
#WORKER_FACT_VERIFY=0
#VERIFY_LLM_BASE_URL=
#VERIFY_LLM_API_KEY=
#VERIFY_LLM_MODEL=

# Ingestion LLM: profile, summary, triplet — same DashScope session (Responses API,
# session-cache via x-dashscope-session-cache). Triplet runs in the session chain.
INGESTION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INGESTION_LLM_API_KEY=
INGESTION_LLM_MODEL=qwen3.7-flash
INGESTION_LLM_API_STYLE=dashscope_responses
INGESTION_LLM_TIMEOUT_MS=60000
INGESTION_LLM_ENABLE_THINKING=false

GEMINI_API_KEY=

# Paddle OCR (Baidu AI Studio) — PDF C/D pages + standalone images (png/jpg/…)
# API root (client appends /jobs and /jobs/{id}) — not .../ocr/jobs
PADDLE_OCR_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr
PADDLE_OCR_API_TOKEN=
PADDLE_OCR_MODEL=PaddleOCR-VL-1.6
PADDLE_OCR_POLL_INTERVAL_SECS=5
PADDLE_OCR_JOB_TIMEOUT_SECS=3600
PADDLE_OCR_BATCH_PAGES=80
PADDLE_OCR_C_PRIME_MAX_SINGLE_JOBS=10
PADDLE_OCR_MAX_JOBS_PER_DOCUMENT=50
# When exceeded, remaining C/D pages degrade: LiteParse text extract (A) then visual raster (E)
PADDLE_OCR_MAX_CONCURRENT_JOBS=5
PADDLE_OCR_RESULT_CACHE_ENABLED=1
PADDLE_OCR_RESULT_CACHE_TTL_SECS=86400

# === LiteParse 已退役（2026-07-31 markitdown 为唯一生产解析器）===
# 以下变量不再生效，保留仅用于历史参考：
# LiteParse (primary PDF parser)
LITEPARSE_OCR_ENABLED=0
# LITEPARSE_OCR_SERVER_URL=
LITEPARSE_OCR_LANGUAGE=zh
LITEPARSE_SCANNED_PAGE_THRESHOLD=100
LITEPARSE_TABLE_GARBLE_THRESHOLD=0.30
LITEPARSE_TABLE_HEAVY_THRESHOLD=10
LITEPARSE_FIG_RATIO_THRESHOLD=0.15
LITEPARSE_FIG_COUNT_THRESHOLD=2
LITEPARSE_TEXT_QUAL_THRESHOLD=0.5
LITEPARSE_DECORATIVE_MAX_AREA=0.03

# ======================================
# 解析器（2026-08-05 按格式分工，见 docs/plans/2026-08-05-parser-pipeline-anydoc.md）
# ======================================
# PDF → liteparse（lit CLI）
LITEPARSE_BIN=lit
LITEPARSE_TIMEOUT_MS=120000
# 扫描版检测阈值：liteparse markdown 非空白字符数低于此值 → 转整本 PaddleOCR。
# 误报仅多花一次 Paddle job（结果仍正确）；漏报则扫描件死档（EmptyIndex 终态）——偏低偏安全。
LITEPARSE_SCANNED_MIN_CHARS=500
# Office/ODF/RTF/EPUB/CSV → anydoc-extract（firecrawl-anydoc；PDF 禁止）
ANYDOC_BIN=anydoc-extract
ANYDOC_TIMEOUT_MS=120000

# ======================================
# Search Mode / Search LLM
# ======================================
SEARCH_MODE=llm_tools
SEARCH_ENABLE_THINKING=true
SEARCH_TOOLS=web_search,web_extractor,code_interpreter
# SEARCH_LLM is deprecated — all search-agent LLM calls now use AGENT_LLM_*.
SEARCH_PROVIDER=brave_llm_context
# Brave LLM Context uses SEARCH_API_KEY with the X-Subscription-Token header.
SEARCH_BASE_URL=https://api.search.brave.com
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=10
SEARCH_MAX_SUB_QUERIES=3
SEARCH_TIMEOUT_MS=30000
SEARCH_CITATION_REQUIRED=true
# Brave search runtime parameters (optional). Applied to all sub-queries.
# SEARCH_LANG=zh
# SEARCH_COUNTRY=CN
# SEARCH_FRESHNESS=pd

# ======================================
# Weather utility (weather_query tool — QWeather: now + multi-day daily + air/warnings/indices)
# ======================================
# OpenWeatherMap free-tier key. When unset, product-e2e full_eval starts a local
# mock (see ensure_weather_defaults). Production needs a real key for live weather.
# OPENWEATHER_API_KEY=
# OPENWEATHER_BASE=https://api.openweathermap.org/data/2.5

# ======================================
# Password Reset Email (163 SMTP compatible)
# ======================================
# Legacy-compatible provider switch. Keep "smtp" for 163 mailbox delivery.
EMAIL_PROVIDER=smtp
# 163 SMTP defaults
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 163 mailbox account and authorization code
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional display name shown in reset emails
SMTP_FROM_NAME="Context OSv6"
# Whether to require TLS when connecting to SMTP
SMTP_TLS=true
# Secret used to hash reset codes and reset tickets
RESET_CODE_SECRET=
# Enable worker-side analytics rollups and anomaly scans
ANALYTICS_ROLLUP_ENABLED=false
ANALYTICS_ROLLUP_INTERVAL_SECS=300

# ======================================
# Object Storage (PRD-required for upload)
# ======================================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
UPLOAD_URL_EXPIRE_SEC=900
DOWNLOAD_URL_EXPIRE_SEC=900
# Maximum single file upload size in bytes (default: 100 MB = 104857600)
AVRAG_MAX_UPLOAD_FILE_SIZE_BYTES=104857600

# ======================================
# Parser Backend（2026-07-31 起：markitdown 为生产唯一文档解析器；
# 原 office parser / PDF renderer / liteparse 服务已退役，对应变量不再生效）
# ======================================
# markitdown CLI 可执行文件（默认 PATH 中的 "markitdown"）。worker 运行环境需
# 预装：pip install 'markitdown[all]'（或 uv tool install markitdown）。
# MARKITDOWN_BIN=markitdown
# 单文档 markitdown 子进程超时（毫秒，默认 120000）。
# MARKITDOWN_TIMEOUT_MS=120000
# struct-query per-doc duckdb 存储目录（app 查询侧与 worker 写入侧必须指向同一
# 目录；默认相对 cwd 的 storage/struct_store）。
# STRUCT_STORE_DIR=storage/struct_store
# 表格监督 loop 单文档最大轮数（默认 40）。
# STRUCT_SUPERVISE_MAX_TURNS=40
# 多模态/三元组抽取（现役，worker 读取）：
# MM_EMBEDDING_IMAGE_TOKEN_ESTIMATE=896
# INGESTION_TRIPLET_ENABLED=0
# INGESTION_VLM_TRIPLET_ENABLED=0
# INGESTION_TRIPLET_MIN_CONFIDENCE=0.6
INGESTION_VLM_SUMMARY_ENABLED=1
# When true, OCR-successful pages still get page_raster multimodal chunks (default: false)
# INGESTION_PAGE_RASTER_WITH_OCR=false
# E2E llm_real PDF corpus (WSL paths via /mnt/e)
# E2E_LLM_REAL_ANTIFRAGILE_PDF=/mnt/e/OneDrive/桌面/知境笔记/Taleb_Antifragile__2012.pdf
# E2E_LLM_REAL_BLACK_SWAN_PDF=/mnt/e/OneDrive/桌面/知境笔记/the-black-swan_-the-impact-of-the-highly-improbable-second-edition-pdfdrive.com-.pdf
# E2E_PDF_MAX_PAGES（仅 llm_real 测试读取，非生产配置）
# E2E_PDF_MAX_PAGES=80
# === PDF Visual Renderer 已退役（2026-07-31 markitdown 为唯一生产解析器）===
# 以下变量不再生效，保留仅用于历史参考：
# PDF_VISUAL_PAGES_PER_CHUNK=4
# PDF_VISUAL_RENDER_STRATEGY=pixmap_72dpi
# INGESTION_PDF_MAX_PAGES=80

# ======================================
# Security Scanning (optional)
# ======================================
# ClamAV daemon host/port for malware scanning.
# If unset or unreachable, scans are skipped (fail-open).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ======================================
# Usage limits (ADR 0006)
# ======================================
# Soft limit = plan rolling units; hard-block only at plan_limit × multiplier.
# USAGE_HARD_CAP_MULTIPLIER=3.0

# ======================================
# Cloud BYOK envelope encryption (ADR-0010 PR7 §3.2)
# ======================================
# 32-byte master key for AES-256-GCM of user provider secrets (LLM / embed / rerank).
# Accepts standard base64 (preferred) or 64-char hex. Fail-closed when unset/malformed:
# store/list/revoke/resolve APIs return byok_master_key_* errors.
# Generate: openssl rand -base64 32
# BYOK_MASTER_KEY=

# ======================================
# Billing: Creem (https://creem.io)
# ======================================
# CREEM_API_KEY=creem_your_api_key
# CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret
# Creem uses product_id (prod_xxx) for checkout sessions.
# CREEM_PRODUCT_PRO=prod_your_pro_product_id
# CREEM_PRODUCT_PLUS=prod_your_plus_product_id
# Optional one-time products for wallet top-up packs (ADR-0010 PR5; amounts ¥50/¥100/¥200):
# CREEM_PRODUCT_TOPUP_50=prod_your_topup_50_product_id
# CREEM_PRODUCT_TOPUP_100=prod_your_topup_100_product_id
# CREEM_PRODUCT_TOPUP_200=prod_your_topup_200_product_id
# Display/charge prices (USD), frozen pricing: Plus $9 / Pro $19 (see
# docs/engineering/DEEPSEEK_STYLE_USAGE_BILLING_DESIGN_2026-07-13.md §5.1).
# CREEM_PRICE_PLUS=9.00
# CREEM_PRICE_PRO=19.00

# ======================================
# Billing: Alipay 当面付 (https://open.alipay.com)
# ======================================
# Flow: checkout calls alipay.trade.precreate -> frontend renders the returned
# qr_code -> user scans with Alipay app -> Alipay POSTs the async notify to
# ALIPAY_NOTIFY_URL -> subscription activates for 30 days (one-off payment,
# no auto-renew). See docs/engineering/ALIPAY_F2F_INTEGRATION_2026-07-17.md.
#
# App credentials: open.alipay.com -> 开放平台 -> 应用 -> 接口加签方式
# (公钥模式 RSA2): ALIPAY_PRIVATE_KEY = 应用私钥, ALIPAY_PUBLIC_KEY = 支付宝公钥
# (obtained after uploading your app public key — NOT the app public key itself).
# ALIPAY_APP_ID=2021xxxxxxxxxxxx
# Paste the raw base64 key content (with or without PEM headers).
# ALIPAY_PRIVATE_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...
# ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...
# Production gateway below; sandbox = https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# Must be publicly reachable; endpoint answers plain "success" as Alipay requires.
# ALIPAY_NOTIFY_URL=https://your-domain.com/webhooks/alipay
# Frozen CNY pricing: Plus ¥49 / Pro ¥129.
# ALIPAY_PRICE_PRO=129.00
# ALIPAY_PRICE_PLUS=49.00

# --- Public satellite deploy (scripts/deploy-public-sites.sh) ---
# Optional overrides; defaults: $HOME/context-os-landing, $HOME/whyiamright, $HOME/cchess
# LANDING_DIR=/home/chuan/context-os-landing
# WHY_DIR=/home/chuan/whyiamright
# CCHESS_DIR=/home/chuan/cchess

# --- Public site origins (frontend build / desktop deep links) ---
# NEXT_PUBLIC_APP_ORIGIN=https://app.contextlm.top
# NEXT_PUBLIC_BRAND_HOME_URL=https://www.contextlm.top

# --- Windows Authenticode (scripts/sign-windows-release.sh) ---
# WINDOWS_CERTIFICATE_FILE=/secure/path/codesign.pfx
# WINDOWS_CERTIFICATE_PASSWORD=
# WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
# SIGN_WINDOWS=1
# SIGN_ALLOW_SELF_SIGNED=1

# MaxMind GeoLite2 City DB for user_context tool (optional; geo degrades to none)
# GEOIP_CITY_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb

# Agent orchestrator: product path always uses the host for rag/search
# (workers + chat exit). Pure chat never enters the orchestrator.
# AGENT_ORCHESTRATOR_V1 is retired (removed 2026-07-20; setting it has no effect).
# Agent orchestrator v2 (ReAct LLM brain: step-wise delegate/evidence_fetch
# loop). Falls back to structural first-wave host when no orchestrator llm is
# configured. Default off.
# AGENT_ORCHESTRATOR_V2=1

# --- SkillOpt optimizer (optional; product AGENT_LLM_* unchanged) ---
# OpenCode Go: https://opencode.ai/docs/go/  endpoint .../zen/go/v1
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_GO_API_KEY=
# QWEN_CHAT_BASE_URL=https://opencode.ai/zen/go/v1
# QWEN_CHAT_API_KEY=
# QWEN_CHAT_MODEL=deepseek-v4-flash
# Ollama Cloud: https://docs.ollama.com/cloud
# OLLAMA_API_KEY=
# OLLAMA_HOST=https://ollama.com

# ======================================
# Weather (QWeather 和风 — preferred JWT)
# ======================================
# Docs: https://dev.qweather.com/docs/configuration/authentication/
# QWEATHER_HOST=https://YOUR_SUBDOMAIN.re.qweatherapi.com
# QWEATHER_KID=your_credential_id
# QWEATHER_PROJECT_ID=your_project_id
# QWEATHER_PRIVATE_KEY_PATH=/absolute/path/to/ed25519-private.pem
# Optional inline PEM instead of path:
# QWEATHER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Legacy OpenWeatherMap (fallback if QWeather unset):
# OPENWEATHER_API_KEY=
# OPENWEATHER_BASE=https://api.openweathermap.org/data/2.5
