{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Context-OS",
  "mainBinaryName": "Context-OS",
  "version": "0.1.0",
  "identifier": "com.contextos.desktop",
  "build": {
    "frontendDist": "../../frontend_next/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --dir ../frontend_next dev",
    "beforeBuildCommand": "pnpm --dir ../frontend_next build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Context-OS",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["context-os", "avrag-desktop"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Context-OS",
    "copyright": "Copyright © Context-OS",
    "shortDescription": "Context-OS Client",
    "longDescription": "Context-OS local knowledge client — license-first, no cloud login required for core use.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../runtime/docker-compose.client.yml",
      "../runtime/README.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
