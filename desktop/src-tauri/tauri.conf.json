{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Context-OS Client",
  "mainBinaryName": "Context-OS",
  "version": "0.2.0",
  "identifier": "com.contextos.desktop",
  "build": {
    "frontendDist": "../../frontend_next/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --dir ../frontend_next dev",
    "beforeBuildCommand": "pnpm --dir ../frontend_next build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Context-OS Client",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["context-os", "avrag-desktop"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Context-OS",
    "copyright": "Copyright © Context-OS",
    "category": "Productivity",
    "shortDescription": "Context-OS Client",
    "longDescription": "Context-OS 客户端 — 本机知识库与 Vector Graph RAG。客户端免费；核心使用无需云登录；连云分享名额与平台模型见定价页。",
    "homepage": "https://context-os.com",
    "license": "Proprietary",
    "licenseFile": "nsis/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../runtime/docker-compose.client.yml",
      "../runtime/README.md",
      { "../runtime/bin/python/*": "python/" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "template": "nsis/installer.nsi",
        "customLanguageFiles": {
          "English": "nsis/languages/English.nsh",
          "SimpChinese": "nsis/languages/SimpChinese.nsh"
        },
        "installerIcon": "icons/nsis/installer.ico",
        "uninstallerIcon": "icons/nsis/installer.ico",
        "headerImage": "icons/nsis/header.bmp",
        "sidebarImage": "icons/nsis/sidebar.bmp",
        "uninstallerHeaderImage": "icons/nsis/uninstaller-header.bmp",
        "startMenuFolder": "Context-OS"
      }
    }
  }
}
