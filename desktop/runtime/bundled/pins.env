# Version pins for Context-OS desktop bundled runtime (Windows x64).
# Consumed by scripts/stage-desktop-bundled-runtime.sh
# Update sha256 after first successful download/assemble (do not invent hashes).

COS_RUNTIME_ID=2026.08.05-pg16.14-vec0.8.5-redis5.0.14.1
COS_RUNTIME_PLATFORM=windows-x64
COS_RUNTIME_ZIP_NAME=cos-runtime-pg16.14-redis5.0.14.1-win-x64.zip

# Public base for published runtime (same host as desktop releases)
DESKTOP_RUNTIME_PUBLIC_BASE="${DESKTOP_RUNTIME_PUBLIC_BASE:-https://app.contextlm.top/releases/desktop/runtime}"

# ── Component sources (assemble mode) ────────────────────────────────────────
# EDB official Windows binaries zip (PostgreSQL License). Confirm filename on
# https://www.enterprisedb.com/download-postgresql-binaries if 404.
PG_WIN_VERSION=16.14
PG_WIN_URL="${PG_WIN_URL:-https://get.enterprisedb.com/postgresql/postgresql-16.14-1-windows-x64-binaries.zip}"
PG_WIN_SHA256=98af1417ba6a8dc30543e560e5407833a3b9e7cc7ed20e73b2006f3aa2f04663

# Redis Windows (R1): tporadowski port of Redis 5.0.14 — historical BSD-style port.
# Prefer over SSPL-era builds for desktop pin clarity. Review THIRD_PARTY on change.
REDIS_WIN_VERSION=5.0.14.1
REDIS_WIN_URL="${REDIS_WIN_URL:-https://github.com/tporadowski/redis/releases/download/v5.0.14.1/Redis-x64-5.0.14.1.zip}"
REDIS_WIN_SHA256=018ea18a35876383cbb5f4cd0258adfc87747cf9d619bce1cf73a2e36f720ccf

# pgvector: drop prebuilt vector.dll + control/sql matching PG 16 into cache, or
# set PGVECTOR_WIN_ZIP to a zip that contains them. Empty = assemble warns only.
PGVECTOR_VERSION=0.8.5
PGVECTOR_WIN_ZIP=https://github.com/andreiramani/pgvector_pgsql_windows/releases/download/0.8.5_16.14/vector.v0.8.5-pg16.zip
PGVECTOR_WIN_SHA256=29163e64e80ac080cea4dfa054217d50f34434b4a6cc3ea22a6c787608e6779f
